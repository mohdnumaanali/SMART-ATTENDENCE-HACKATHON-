# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB connection string (falls back cleanly to in-memory Demo Mode if unreachable)
MONGO_URI="mongodb://localhost:27017/hackathonDB"
JWT_SECRET="change-this-jwt-secret"
PORT=3000
